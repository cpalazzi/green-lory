# Ignore everything by default
*

# But allow git to traverse directories
!*/

# Always keep these control files
!.gitignore
!.gitkeep
!**/.gitkeep

# Allow common source/config/doc formats
!*.py
!*.sh
!*.ipynb
!*.csv
!*.md
!*.txt
!*.yaml
!*.yml
!pytest.ini
!pyproject.toml

# Reconciliation package: frozen legacy cost workbooks and small experiment configs
!/legacy_lcoa/source/**/*.xlsx
!/reconciliation/**/*.json
!/inputs/**/*.json

# Never commit virtualenvs or Python caches
.venv/
references/
# link to legacy_gpo/ of the green-porpoise repository (the published network); not tracked here
/legacy_gpo
**/__pycache__/
**/*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Keep repository structure but not bulky/generated inputs/outputs
# (we still keep .gitkeep in each)
/data/**
!/data/**/.gitkeep
!/data/README.md
!/data/**/

/results/**
!/results/**/.gitkeep
!/results/README.md
!/results/**/
!/results/**/README.md

# Only the documented helper scripts are part of the supported interface.
# Local diagnostics and Copilot scratch helpers under scripts/ stay ignored.
/scripts/*
!/scripts/README.md
!/scripts/**/.gitkeep
!/scripts/fetch_travel_time.py

# Claude session ARC file-queue bridge (local operational scratch)
arc_exchange/

# Generated finance overrides for the key runs (python -m model.finance);
# their hashes are pinned in the ARC release manifests
/inputs/uniform_interest_inputs_0p05_2050.csv
/inputs/amelired_interest_inputs_2050_center.csv

# pip install -e . metadata
*.egg-info/
