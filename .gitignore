# Ignore everything by default
*

# But allow git to traverse directories
!*/

# Always keep these control files
!.gitignore
!.gitkeep
!**/.gitkeep

# Allow common source/config/doc formats
!*.py
!*.sh
!*.ipynb
!*.csv
!*.md
!*.txt
!*.yaml
!*.yml
!pytest.ini
!pyproject.toml

# Reconciliation package: frozen legacy cost workbooks and small experiment configs
!/legacy_lcoa/source/**/*.xlsx
!/reconciliation/**/*.json
!/inputs/**/*.json

# Never commit virtualenvs or Python caches
.venv/
references/
# link to legacy_gpo/ of the green-porpoise repository (the published network); not tracked here
/legacy_gpo
**/__pycache__/
**/*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Keep repository structure but not bulky/generated inputs/outputs
# (we still keep .gitkeep in each)
/data/**
!/data/**/.gitkeep
!/data/README.md
!/data/**/

/results/**
!/results/**/.gitkeep
!/results/README.md
!/results/**/
!/results/**/README.md
# copies of the green-porpoise archive (legacy_gpo extract-archive) keep their own README
/results/**/git-0a63616/**

# Finance tables keyed by cell are large and made outside the repository, so not tracked:
# runs.yaml pins their hashes and arc/stage_release.sh copies them into releases. Finance tables
# keyed by country are small and tracked.
/inputs/finance/*
!/inputs/finance/*_by_country.csv

# pip install -e . metadata
*.egg-info/
